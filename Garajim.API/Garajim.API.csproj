<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <SelfContained>false</SelfContained>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="188743680" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.14" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ML" Version="5.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Garajim.Business\Garajim.Business.csproj" />
    <ProjectReference Include="..\Garajim.ML\Garajim.ML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="MLModels\price-model.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('appsettings.Development.json')">
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <MsDeploySkipRules Include="AppDataKlasoruSilinmesin">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>App_Data</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="AppDataDosyalariSilinmesin">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>App_Data\\.*</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>

  <UsingTask TaskName="YenilikleriUret" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Kaynak ParameterType="System.String" Required="true" />
      <Hedef ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var satirlar = System.IO.File.ReadAllLines(Kaynak);
        var sb = new System.Text.StringBuilder();
        var maddeler = new System.Collections.Generic.List<string>();
        string baslik = null;
        var ilk = true;

        System.Func<string, string> kacir = m => m.Replace("\\", "\\\\").Replace("\"", "\\\"");

        System.Action yaz = () =>
        {
            if (baslik == null) return;
            if (!ilk) sb.Append(",");
            ilk = false;
            sb.Append("{\"baslik\":\"").Append(kacir(baslik)).Append("\",\"maddeler\":[");
            for (var i = 0; i < maddeler.Count; i++)
            {
                if (i > 0) sb.Append(",");
                sb.Append("\"").Append(kacir(maddeler[i])).Append("\"");
            }
            sb.Append("]}");
        };

        sb.Append("[");

        foreach (var ham in satirlar)
        {
            var satir = ham.Trim();
            if (satir.StartsWith("## "))
            {
                yaz();
                baslik = satir.Substring(3).Trim();
                maddeler = new System.Collections.Generic.List<string>();
            }
            else if (satir.StartsWith("- ") && baslik != null)
            {
                maddeler.Add(satir.Substring(2).Trim());
            }
        }

        yaz();
        sb.Append("]");

        System.IO.File.WriteAllText(Hedef, sb.ToString(), new System.Text.UTF8Encoding(false));
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="DegisiklikGunlugunuCevir" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildProjectDirectory)/../CHANGELOG.md')">
    <YenilikleriUret Kaynak="$(MSBuildProjectDirectory)/../CHANGELOG.md" Hedef="$(MSBuildProjectDirectory)/wwwroot/yenilikler.json" />
  </Target>

</Project>
